{
    "name": "textileria/sistema",
    "description": "Sistema ERP Textileria - migrado a Symfony 8.2 / PHP 8.4",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.5.1",
        "doctrine/doctrine-bundle": "^3.4.1",
        "doctrine/orm": "^3.7",
        "phpoffice/phpspreadsheet": "^5.11",
        "smarty/smarty": "^4.5.8",
        "symfony/console": "8.2.*",
        "symfony/dotenv": "8.2.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.2.*",
        "symfony/mime": "8.2.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "8.2.*",
        "symfony/twig-bundle": "8.2.*",
        "symfony/yaml": "8.2.*",
        "twig/extra-bundle": "^3.29",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "symfony/browser-kit": "8.2.*",
        "symfony/debug-bundle": "8.2.*",
        "symfony/stopwatch": "8.2.*",
        "symfony/web-profiler-bundle": "8.2.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "legacy/compat/php8.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*",
            "docker": false
        }
    }
}

<!DOCTYPE html>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/> 
<html>
<head>
    {% include '_favicon.html.twig' %}
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="/erp/jquery-ui-1.11.0/jquery-ui.min.css">
   <script type="text/javascript" src="/erp/jquery-1.10.2.min.js"></script> 
   <script type="text/javascript" src="/erp/jquery-ui-1.11.0/jquery-ui.min.js"></script>
   <script type="text/javascript" src="/erp/Libgen.js"></script>
   <script>
   $(document).ready(function() {
   $("#pdFecFin").datepicker();
});
   </script>
   <title>TEXTILERIA</title>
</head>
<body>
<form action="ERP1010.php#no-back" method="post">
   {% if maintenanceToken is defined and maintenanceToken is not null %}<input type="hidden" name="_token" value="{{ maintenanceToken|default('') }}" />{% endif %}
   <div class="wrapper">
   <div id="MH">
           <ul>
                <li style="margin-left: 50px;"><h1>Mantenimiento de Usuarios</h1></li>
				<li style="float:right;margin-right: 100px;"><a onclick="self.location = 'index.php'"> Cerrar Sesión</a></li>
           </ul>
   </div>
   <div id="topnavbar"></div>
   <div id="navigation">
   <div id="navcontainer">
   {% if maintenanceMessage is defined and maintenanceMessage is not null and maintenanceMessage|default('') != '' %}<p role="status">{{ maintenanceMessage|default('') }}</p>{% endif %}
   {% if scBehavior|default('') == "0" %}
      <div style="overflow:scroll; height:500px; width:800px; overflow:auto; border: 1px">
      <table border=2 style="font-size:11px">
         <th bgcolor="#F29818" align="center">Código</th>
         <th bgcolor="#F29818" width="500" align="center">Nombre</th>
         <th bgcolor="#F29818" width="100" align="center">Perfil</th>
         <th bgcolor="#F29818" align="center"><img src="/erp/Check.jpg" width="25" height="25"></th>
         {% for i in saCodUsu|default([]) %}               
            <tr>
            <td>{{ i[0] }}</td><td>{{ i[1] }}</td><td>{{ i[2] }}</td>
            <td><input type="radio" name="pcCodUsu" value="{{ i[0] }}"/></td>
            </tr>
         {% endfor %}
      </table>
      </div>
      <table>
         <tr>
         <td><input type="submit" name="Boton1" value="Editar" /></td>
         <td><input type="submit" name="Boton1" value="Nuevo" /></td>
         <td><input type="submit" name="Boton1" value="Salir" /></td>
         </tr>
      </table>
   {% elseif scBehavior|default('') == "1" %}
      <fieldset>
      <table style="font-size:11px">
         <tr>
         <td>Código:</td>
         <td><font color=blue>{{ scCodUsu|default('') }}</font><input type="hidden" name="pcCodUsu" value="{{ scCodUsu|default('') }}"/></td>
         </tr><tr>
         <td>Nombre:</td>
         <td><font color=blue>{{ scNombre|default('') }}</font><input type="hidden" name="pcNombre" value="{{ scNombre|default('') }}"/></td>
         </tr><tr>
         <td>Estado:</td>
         <td>
            <select name="pcEstado">
            {% for i in saEstado|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstado|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>
         <td>Perfil:</td>
         <td>
            <select name="pcPerfil">
            {% for i in saPerfil|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scPerfil|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>
         <td>F.Expiración Clave:</td>
         <td><input type="text" maxlength="10" id="pdFecFin"name="pdFecFin" value="{{ sdFecFin|default('') }}" size="12" placeholder="aaaa-mm-dd"/></td>
         </tr>
      </table>
      </fieldset>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton2" value="Actualizar" /></td>
         <td><input type="submit" name="Boton2" value="Cancelar" /></td>
         </tr>
      </table>
   {% elseif scBehavior|default('') == "2" %}
      <table border=1 style="font-size:11px">
         <tr>
         <td>Personal:</td>
         <td>
            <select name="pcCodPer">
            {% for i in saCodPer|default([]) %}
               <option value="{{ i[0] }}">{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr> 
         <td>Perfil:</td>
         <td>
            <select name="pcPerfil">
            {% for i in saPerfil|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scPerfil|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
      </table>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton3" value="Grabar" /></td>
         <td><input type="submit" name="Boton3" value="Cancelar" /></td>
         </tr>
      </table>
   {% endif %}
   </div>
   </div>
   <div id="content"></div>
   <div id="footer"></div>
   </div>
</form>
</body>
</html>
<!DOCTYPE html>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/> 
<html>
<head>
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <title>TEXTILERIA</title>
   <script src="/erp/Libreria.js" language="JavaScript"></script>
</head>
<body>
<form action="ERP1040.php#no-back" method="post">
   {% if maintenanceToken is defined and maintenanceToken is not null %}<input type="hidden" name="_token" value="{{ maintenanceToken|default('') }}" />{% endif %}
   <div class="wrapper">
   <div id="MH">
           <ul>
                <li style="margin-left: 50px;"><h1>Mantenimiento de Maquinas</h1></li>
				<li style="float:right;margin-right: 100px;"><a onclick="self.location = 'index.php'"> Cerrar Sesión</a></li>
           </ul>
   </div>
   <div id="topnavbar"></div>
   <div id="navigation">
   <div id="navcontainer">
   {% if maintenanceMessage is defined and maintenanceMessage is not null and maintenanceMessage|default('') != '' %}<p role="status">{{ maintenanceMessage|default('') }}</p>{% endif %}
   {% if scBehavior|default('') == "0" %}
      <table>
         <tr>
         <td>Maquinas:</td>
         <td>
            <select name="pcCodMaq">
            {% for i in saCodMaq|default([]) %}
               <option value="{{ i[0] }}">{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr>
      </table>
      <table>
         <td><input type="submit" name="Boton1" value="Aplicar" /></td>
         <td><input type="submit" name="Boton1" value="Nuevo" /></td>
         <td><input type="submit" name="Boton1" value="Salir" /></td>
      </table>
   {% elseif scBehavior|default('') == "1" %}
      <table style="font-size:11px">
         <tr>
         <td>Código:</td>
         {% if not scCodMaq|default %}
            <td></td>
         {% else %}
            <td><font color=blue>{{ scCodMaq|default('') }}</font><input type="hidden" maxlength="6" name="pcCodMaq" value="{{ scCodMaq|default('') }}"/></td>
         {% endif %}
         </tr><tr>
         <td>Descripcion:</td>
         <td><input type="text" maxlength="50" name="pcNomMaq" value="{{ scNomMaq|default('') }}" size="60" style="text-transform:uppercase;"/></td>
         </tr><tr>
         <td>Estado:</td>
         <td>
            <select name="pcEstado">
            {% for i in saEstado|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstado|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>
         <td>Tipo de Maquina:</td>
         <td>
            <select name="pcTipo">
            {% for i in saTipo|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scTipo|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr>
      </table>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton2" value="Grabar"/></td>
         <td><input type="submit" name="Boton2" value="Cancelar"/></td>
         </tr>
      </table>
   {% elseif scBehavior|default('') == "2" %}
      <table style="font-size:11px">
         <tr>
         <td>Nombre:</td>
         <td><input type="text" maxlength="50" name="pcNomMaq" value="{{ scNomMaq|default('') }}" size="60" style="text-transform:uppercase;"/></td>
         </tr><tr>
         <td>Estado:</td>
         <td>
            <select name="pcEstado">
            {% for i in saEstado|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstado|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr>
		 <tr>
         <td>Tipo de Maquina:</td>
         <td>
            <select name="pcTipo">
            {% for i in saTipo|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scTipo|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>

      </table>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton2" value="Grabar"/></td>
         <td><input type="submit" name="Boton2" value="Cancelar"/></td>
         </tr>
      </table>
   {% endif %}
   </div>
   </div>
   <div id="content"></div>
   <div id="footer"></div>
   </div>
</form>
</body>
</html>
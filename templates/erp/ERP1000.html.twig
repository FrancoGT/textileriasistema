<!DOCTYPE html>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/> 
<html>
<head>
    {% include '_favicon.html.twig' %}
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="/erp/jquery-ui-1.11.0/jquery-ui.min.css">
   <script type="text/javascript" src="/erp/jquery-1.10.2.min.js"></script> 
   <script type="text/javascript" src="/erp/jquery-ui-1.11.0/jquery-ui.min.js"></script>
   <script type="text/javascript" src="/erp/Libgen.js"></script>
   <title>TEXTILERIA</title>   
</head>
<body>
<form action="ERP1000.php#no-back" method="post">
   {% if maintenanceToken is defined and maintenanceToken is not null %}<input type="hidden" name="_token" value="{{ maintenanceToken|default('') }}" />{% endif %}
   <div class="wrapper">
   <div id="MH">
           <ul>
                <li style="margin-left: 50px;"><h1>Mantenimiento de Personal</h1></li>
				<li style="float:right;margin-right: 100px;"><a onclick="self.location = 'index.php'"> Cerrar Sesión</a></li>
           </ul>
   </div>
   <div id="topnavbar"></div>
   <div id="navigation">
   <div id="navcontainer">
   {% if maintenanceMessage is defined and maintenanceMessage is not null and maintenanceMessage|default('') != '' %}<p role="status">{{ maintenanceMessage|default('') }}</p>{% endif %}
   {% if scBehavior|default('') == "0" %}
      <table>
         <tr>
         <td>Personal:</td>
         <td>
            <select name="pcCodPer">
            {% for i in saCodPer|default([]) %}
               <option value="{{ i[0] }}">{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr>
      </table>
      <table>
         <td><input type="submit" name="Boton1" value="Aplicar" /></td>
         <td><input type="submit" name="Boton1" value="Nuevo" /></td>
         <td><input type="submit" name="Boton1" value="Salir" /></td>
      </table>
   {% elseif scBehavior|default('') == "1" %}
      <table style="font-size:11px">
         <tr>
         <td>Código:</td>
         {% if not scCodPer|default %}
            <td></td>
         {% else %}
            <td><font color=blue>{{ scCodPer|default('') }}</font><input type="hidden" maxlength="6" name="pcCodPer" value="{{ scCodPer|default('') }}"/></td>
         {% endif %}
         </tr><tr>
         <td>Nombre:</td>
         <td><input type="text" maxlength="90" name="pcNombre" value="{{ scNombre|default('') }}" size="60" style="text-transform:uppercase;"/></td>
         </tr><tr>
         <td>Dirección:</td>
         <td><input type="text" maxlength="90" name="pcDirecc" value="{{ scDirecc|default('') }}" size="60" style="text-transform:uppercase;"/></td>
         </tr><tr>
         <td>E-Mail:</td>
         <td><input type="text" maxlength="90" name="pcEmail" value="{{ scEmail|default('') }}" size="60" style="text-transform:uppercase;"/></td>
         </tr><tr>    
         <td>Nro.DNI:</td>
         <td><input type="text" class="input_num" maxlength="8" name="pcNroDni" value="{{ scNroDni|default('') }}" size="8" /></td>
         </tr><tr>    
         <td>Sexo:</td>
         <td>
            <select name="pcSexo" >
            {% for i in saSexo|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scSexo|default('') %} selected {% endif %}>{{ i[1] }} </option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>
         <td>Estado Civil:</td>
         <td>
            <select name="pcEstCiv" >
            {% for i in saEstCiv|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstCiv|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>    
         <td>Estado:</td>
         <td>
            <select name="pcEstado">
            {% for i in saEstado|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstado|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr>
      </table>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton2" value="Grabar"/></td>
         <td><input type="submit" name="Boton2" value="Cancelar"/></td>
         </tr>
      </table>
   {% elseif scBehavior|default('') == "2" %}
      <table>
         <tr>
         <td>Nombre:</td>
         <td><input type="text" maxlength="90" name="pcNombre" size="60" value="{{ scNombre|default('') }}"style="text-transform:uppercase;"/></td>
         </tr><tr>
         <td>Direccion:</td>
         <td><input type="text" maxlength="90" name="pcDirecc" size="60" value="{{ scDirecc|default('') }}"style="text-transform:uppercase;"/></td>
         </tr><tr>
         <td>E-Mail:</td>
         <td><input type="text" maxlength="90" name="pcEmail" value="{{ scEmail|default('') }}" size="60"style="text-transform:uppercase;"/></td>
         </tr><tr>    
         <td>Nro.DNI:</td>
         <td><input type="text" class="input_num" maxlength="8" name="pcNroDni" value="{{ scNroDni|default('') }}" size="8"/></td>
         </tr><tr> 
         <td>Sexo:</td>
         <td>
            <select name="pcSexo">
            {% for i in saSexo|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scSexo|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr> 
         <td>Estado Civil:</td>
         <td>
            <select name="pcEstCiv">
            {% for i in saEstCiv|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstCiv|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>       
         <td>Estado:</td>
         <td>
            <select name="pcEstado">
            {% for i in saEstado|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstado|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
      </table>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton2" value="Grabar"/></td>
         <td><input type="submit" name="Boton2" value="Cancelar"/></td>
         </tr>
      </table>
   {% endif %}
   </div>
   </div>
   <div id="content"></div>
   <div id="footer"></div>
   </div>
</form>
</body>
</html>

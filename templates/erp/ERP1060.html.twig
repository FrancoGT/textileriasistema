<!DOCTYPE html>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<html>
<head>       
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="/erp/jquery-ui-1.11.0/jquery-ui.min.css">
   <script type="text/javascript" src="/erp/jquery-1.10.2.min.js"></script> 
   <script type="text/javascript" src="/erp/jquery-ui-1.11.0/jquery-ui.min.js"></script>
   <script type="text/javascript" src="/erp/Libgen.js"></script>   <script language="JavaScript">
	function f_Desactivar(){
	
           var seleccion = document.getElementById('jcTipPer');           
           if(seleccion.selectedIndex=="2"){               document.getElementById('jcRuc').disabled=true;              
           }else{
               document.getElementById('jcRuc').disabled=false;
           }
       }
	$(document).ready(function() {
   $("#pdFecNac").datepicker();
   });
   </script>   
   <title>TEXTILERIA</title>
</head>
<body onload=f_Desactivar()>
<form action="ERP1060.php#no-back" method="post">
   {% if maintenanceToken is defined and maintenanceToken is not null %}<input type="hidden" name="_token" value="{{ maintenanceToken|default('') }}" />{% endif %}
   <div class="wrapper">
   <div id="MH">
           <ul>
                <li style="margin-left: 50px;"><h1>Mantenimiento de Proveedores</h1></li>
				<li style="float:right;margin-right: 100px;"><a onclick="self.location = 'index.php'"> Cerrar Sesión</a></li>
           </ul>
   </div>
   <div id="topnavbar"></div>
   <div id="navigation">
   <div id="navcontainer">
   {% if maintenanceMessage is defined and maintenanceMessage is not null and maintenanceMessage|default('') != '' %}<p role="status">{{ maintenanceMessage|default('') }}</p>{% endif %}
   {% if scBehavior|default('') == '0' %}         
      <div style="overflow:scroll; height:200px; width:800px; overflow:auto; border: 1px">
      <table border = 2 style = "font-size:11px">
         <th bgcolor="#F29818"width="100" align="center">RUC</th>
         <th bgcolor="#F29818"align="center" width="300">Razón Social</th>
         <th bgcolor="#F29818"align="center">Estado</th>         
         <th bgcolor="#F29818"align="center"><img src="/erp/Check.jpg" width="25" height="25"></th>         
         {% for i in saData|default([]) %}               
            <tr>
                <td>{{ i[1] }}</td><td>{{ i[2] }}</td><td>{{ i[3] }}</td>                
                <td><input type="radio" name="pcCodPrv" value = "{{ i[0] }}"/></td>
            </tr>            
         {% endfor %}            
      </table>
      </div>         
      <table>
         <tr>
         <td><input type="submit" name="Boton0" value="Nuevo" /></td>         
         <td><input type="submit" name="Boton0" value="Editar" /></td>                  
         <td><input type="submit" name="Boton0" value="Salir" /></td>         
         </tr>
      </table>   
      {% elseif scBehavior|default('') == '1' %}      
      <table>
         <tr>
         <td>Nombre/Razón Social:</td>
         {% if flag|default('') == 'nuevo' %}
         <td><input type="text" name="pcNombre" value="{{ scNombre|default('') }}" size="80"style="text-transform:uppercase;"></td> 
         {% else %}      
         <td>{{ scNombre|default('') }}</td> 
		 <td><input type="hidden" maxlength="70" name="pcNombre" size="70" value="{{ scNombre|default('') }}"/></td>
         {% endif %}
         <input type="hidden" name="pcCodPrv" value="{{ scCodPrv|default('') }}" size="80"style="text-transform:uppercase;">
         </tr><tr>                           
         <td>Tipo de Persona:</td>
         <td>
             {% if flag|default('') == 'nuevo' %}
                <select name="pcTipPer" id="jcTipPer" onchange="f_Desactivar()">
               {% for i in saTipPer|default([]) %}
                   <option value = "{{ i[0] }}" {% if scTipPer is defined and scTipPer is not null and i[0] == scTipPer|default('') %}selected{% endif %}>{{ i[1] }} </option>
               {% endfor %}
               </select>
               {% else %}
               <select name="pcTipPer" id="jcTipPer" disabled='true'>
               {% for i in saTipPer|default([]) %}
                   <option value = "{{ i[0] }}" {% if scTipPer is defined and scTipPer is not null and i[0] == scTipPer|default('') %}selected{% endif %}>{{ i[1] }} </option>
               {% endfor %}
               </select>
               
            {% endif %}
         </td>
         </tr><tr>
         <td>DNI:</td>
         {% if flag|default('') == 'nuevo' %}
         <td><input type="text" class="input_num"name="pcNroDni" value="{{ scNroDni|default('') }}" maxlength="8" id="jcDni" size="8"></td>
         {% else %}
         <td>{{ scNroDni|default('') }}</td>
         {% endif %}
         </tr><tr>
         <td>RUC:</td>
         {% if flag|default('') == 'nuevo' %}
         <td><input type="text" class="input_num"name="pcNroRuc" value="{{ scNroRuc|default('') }}" maxlength="11" size="11" id="jcRuc"></td> 
         {% else %}
         <td>{{ scNroRuc|default('') }}</td> 
         {% endif %}
         </tr><tr>
         <td>Fecha de Surgimiento:</td>
         {% if flag|default('') == 'nuevo' %}
         <td><input type="text" name="pdFecNac" id='pdFecNac'value="{{ sdFecNac|default('') }}" maxlength="11" placeholder="aaaa-mm-dd" size="11"></td> 
         {% else %}
         <td>{{ sdFecNac|default('') }}</td> 
         {% endif %}
         </tr><tr>         
         <td>Dirección:</td>
         <td><input type="text" name="pcDirecc" value="{{ scDirecc|default('') }}" size="80" style="text-transform:uppercase;"></td>                          
         </tr><tr>                      
         <td>Otros Datos:</td>                           
         <td><textarea name="pcTexCon" id="pcTexCon" rows="10" cols="80" style="text-transform:uppercase;"></textarea></td> 
         </tr><tr>
         <td>Línea de Producción:</td>  
         <td>
            {% for i in saTipos|default([]) %}                            
                <input type="checkbox" name ="paTipArs[]" value = "{{ i[0] }}" id="jcArsTip"
                       {% for a in saArsTip|default([]) %}                           
                       {% if i[0] == a[0] %} checked {% endif %}{% endfor %}/>{{ i[1] }}<br /> 
            {% endfor %}          
         </td>         
         </tr>
      </table>                  
      <table>
         <tr>
         <td><input type="submit" name="Boton1" value="Grabar" /></td>                  
         <td><input type="submit" name="Boton1" value="Cancelar" /></td>         
         </tr>
      </table>          
      {% endif %}
   </div>
   </div>
   <div id="content"></div>
   <div id="footer"></div>
   </div>
</form>
</body>
</html>

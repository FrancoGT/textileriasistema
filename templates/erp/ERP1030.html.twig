	 {% endif %}

	 {% if scTipo|default('') == 'A' %}
	 {% else %}
	 <tr>
         <td>SIGLAS:</td>
         <td><input type="text" maxlength="4" name="pcSiglas" size="11" value="{{ scSiglas|default('') }}" style="text-transform:uppercase;"/></td>

       <table>         
           <tr>
         <td>Tipo de Persona:</td>
         <td>
            <select name="pcTipCli">
            {% for i in saTipCli|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scTipCli|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr>
         </table>
      <table>
         <td><input type="submit" name="Aceptar" value="Aceptar"/></td>
		 <td><input type="submit" name="Salir" value="Salir"/></td>
      </table>
   {% elseif scBehavior|default('') == "1" %}
       <table>
         <tr>
         <td>Nombre/Razón Social:</td>
         <td><input type="text" maxlength="70" name="pcNombre" size="70" value="{{ scNombre|default('') }}" style="text-transform:uppercase;"/></td>
         </tr>
		 
		 {% if scTipo|default('') == 'A' %}
		 <tr>		 
         <td>DNI:</td>
         <td><input type="text" class="input_num" name="pcNroDNI" size="8" maxlength="8" value="{{ scNroDNI|default('') }}" /></td>
         </tr>
		 {% else %}
		 <tr>
         <td>RUC:</td>
         <td><input type="text" class="input_num" name="pcNroRUC" size="11" maxlength="11" value="{{ scNroRUC|default('') }}" /></td>
         </tr>
		 {% endif %}
		 <tr>
         <td>Estado:</td>
         <td>
            <select name="pcEstado">
            {% for i in saEstado|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scEstado|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
         </td>
         </tr><tr>
         <td>Dirección:</td>
         <td><input type="text" maxlength="70" name="pcDirec" size="51" value="{{ scDirec|default('') }}" style="text-transform:uppercase;"/></td>
         </tr>
		 
		 <tr>
         <td>Telefono:</td>
         <td><input type="text" class="input_num" maxlength="15" name="pcTelef" size="15" value="{{ scTelef|default('') }}" /></td>
         </tr>

		 {% if scTipo|default('') == 'A' %}
		 {% else %}
		 <tr>		 

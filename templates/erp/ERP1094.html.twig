<!DOCTYPE html>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/> 
<html>
<head>
    {% include '_favicon.html.twig' %}
      <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="/erp/jquery-ui-1.11.0/jquery-ui.min.css">
   <script type="text/javascript" src="/erp/jquery-1.10.2.min.js"></script> 
   <script type="text/javascript" src="/erp/jquery-ui-1.11.0/jquery-ui.min.js"></script>
   <script type="text/javascript" src="/erp/Libgen.js"></script>

   <title>TEXTILERIA</title>
   <script src="/erp/Libreria.js" language="JavaScript"></script>
</head>
<body>
<form action="ERP1094.php#no-back" method="post">
   {% if maintenanceToken is defined and maintenanceToken is not null %}<input type="hidden" name="_token" value="{{ maintenanceToken|default('') }}" />{% endif %}
   <div class="wrapper">
   <div id="MH">
           <ul>
                <li style="margin-left: 50px;"><h1>Mantenimiento de Cuentas</h1></li>
				<li style="float:right;margin-right: 100px;"><a onclick="self.location = 'index.php'"> Cerrar Sesión</a></li>
           </ul>
   </div>
   <div id="topnavbar"></div>
   <div id="navigation">
   <div id="navcontainer">
   {% if maintenanceMessage is defined and maintenanceMessage is not null and maintenanceMessage|default('') != '' %}<p role="status">{{ maintenanceMessage|default('') }}</p>{% endif %}
   {% if scBehavior|default('') == "0" %}
      <table border = 0>
         <tr>
         <td><input type="radio" name="pcTipo" value="1">Cuentas de Proveedores</td>
         </tr><tr>
         <td><input type="radio" name="pcTipo" value="2">Cuentas de Bancos</td>
         </tr>
      </table>
      <table>
         <td><input type="submit" name="Boton1" value="Nuevo" /></td>
         <td><input type="submit" name="Boton1" value="Salir" /></td>
      </table>
   {% elseif scBehavior|default('') == "1" %}
      <table>
	  {% if scTipo|default('') == "1" %}
	  <tr>
         <td>Proveedores:</td>
         <td>
            <select name="pcCodPrv">
            {% for i in saCodPrv|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scCodPrv|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
	     </td>
         </tr>
	  {% elseif scTipo|default('') == "2" %}
	  <tr>
         <td>Bancos:</td>
         <td>
            <select name="pcCodBan">
            {% for i in saCodBan|default([]) %}
               <option value="{{ i[0] }}" {% if i[0] == scCodBan|default('') %} selected {% endif %}>{{ i[1] }}</option>
            {% endfor %}
            </select>
	     </td>
         </tr>
	  {% endif %}
	  <tr>    
         <td>Nro. de Cuenta:</td>
         <td><input type="text" class="input_num" maxlength="14" name="pcNroCta" value="{{ scNroCta|default('') }}" size="14" /></td>
         </tr>
	  </table>
      <table>
         <tr>
         <td></td>
         <td><input type="submit" name="Boton2" value="Grabar"/></td>
         <td><input type="submit" name="Boton2" value="Cancelar"/></td>
         </tr>
      </table>
   {% endif %}
   </div>
   </div>
   <div id="content"></div>
   <div id="footer"></div>
   </div>
</form>
</body>
</html>
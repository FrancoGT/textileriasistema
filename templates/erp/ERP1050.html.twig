<!DOCTYPE html>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<html>
<head>
    {% include '_favicon.html.twig' %}
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link href="/erp/Sixavi.css" media="screen" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="/erp/jquery-ui-1.11.0/jquery-ui.min.css">
   <script type="text/javascript" src="/erp/jquery-1.10.2.min.js"></script> 
   <script type="text/javascript" src="/erp/jquery-ui-1.11.0/jquery-ui.min.js"></script>
   <script type="text/javascript" src="/erp/Libgen.js"></script>
   <script>
   $(document).ready(function() {
   $("#pdFecFin").datepicker();
});
   </script>
   <title>TEXTILERIA</title>
</head>
<body>
<form action="ERP1050.php#no-back" method="post">
   {% if maintenanceToken is defined and maintenanceToken is not null %}<input type="hidden" name="_token" value="{{ maintenanceToken|default('') }}" />{% endif %}
   <div class="wrapper">
   <div id="MH">
           <ul>
                <li style="margin-left: 50px;"><h1>Mantenimiento de Insumos</h1></li>
				<li style="float:right;margin-right: 100px;"><a onclick="self.location = 'index.php'"> Cerrar Sesión</a></li>
           </ul>
   </div>
   <div id="topnavbar"></div>
   <div id="navigation">
   <div id="navcontainer">
   {% if maintenanceMessage is defined and maintenanceMessage is not null and maintenanceMessage|default('') != '' %}<p role="status">{{ maintenanceMessage|default('') }}</p>{% endif %}
   {% if scBehavior|default('') == '0' %}                
         <div style="overflow:scroll; height:300px; width:1000px; overflow:auto; border: 1px">
         <table border = 2 style = "font-size:11px">
         <th bgcolor="#F29818" width="400" align="center">Nombre</th>
         <th bgcolor="#F29818" width="200"align="center">Tipo de Artículo</th>
         <th bgcolor="#F29818" align="center">Unidad de Medida</th>         
         <th bgcolor="#F29818" align="center">Granulado</th> 
         <th bgcolor="#F29818" align="center">Precio por Unidad</th>         
         <th bgcolor="#F29818" align="center"><img src="/erp/Check.jpg" width="25" height="25"></th>         
         {% for i in saData|default([]) %}               
            <tr>
                <td>{{ i[1] }}</td><td>{{ i[2] }}</td><td>{{ i[3] }}</td>
                <td>{{ i[4] }}</td><td>{{ i[5] }}</td>
                <td><input type="radio" name="pcCodArs" value = "{{ i[0] }}"/></td>
            </tr>            
         {% endfor %}            
      </table>
      </div>      
      <table>
         <tr>
         <td><input type="submit" name="Boton1" value="Nuevo" /></td>         
         <td><input type="submit" name="Boton1" value="Editar" /></td>         
         <td><input type="submit" name="Boton1" value="Eliminar" /></td>         
         <td><input type="submit" name="Boton1" value="Salir" /></td>         
         </tr>
      </table>   
       {% elseif scBehavior|default('') == '1' %}
      <table>         
         <tr>   
          <td>Subtipo de Producto:</td>
         {% if scCodIns|default('') %}
         <td>
             <input type="hidden" name="pcCodIns" value="{{ scCodIns|default('') }}">
             <select name="pcSubTip" disabled="true">
            {% for i in saSubTip|default([]) %}
               <option value = "{{ i[0] }}" {% if i[0] == scSubTip|default('') %} selected {% endif %}>{{ i[1] }} </option>               
            {% endfor %}
            </select>
         </td>     
         {% else %}
            <td>                
                <select name="pcSubTip">
                {% for i in saSubTip|default([]) %}
                    <option value = "{{ i[0] }}" {% if i[0] == scSubTip|default('') %} selected {% endif %}>{{ i[1] }} </option>
                {% endfor %}
                </select>
            </td>     
         {% endif %}
         </tr><tr>
         <td>Descripción:</td>
         {% if scCodIns|default('') %}
             <td>{{ scDescri|default('') }}<input type="hidden" name="pcDescri" value="{{ scDescri|default('') }}"style="text-transform:uppercase;"></td>                 
         {% else %}
            <td><input type="text" name="pcDescri" value="{{ scDescri|default('') }}"style="text-transform:uppercase;"></td>                 
         {% endif %}                     
         </tr>         
         <tr>
         <td>Unidad:</td>         
         <td>
            <select name="pcUniMed">
            {% for i in saUniMed|default([]) %}
               <option value = "{{ i[0] }}" {% if i[0] == scUniMed|default('') %} selected {% endif %}>{{ i[1] }} </option>               
            {% endfor %}
            </select>
         </td>              
         </tr>
         <tr>         
         <td>Granulado:</td>
         <td><input type="text" class="input_num" name="pnCanGra" value="{{ snCanGra|default('') }}"></td> 
         </tr>                 
         <tr>         
         <td>Precio:</td>
         <td><input type="text" class="input_num" name="pnPrecio" value="{{ snPrec|default('') }}"></td>                 
         </tr>

      </table>            
      <table>
         <tr>
         <td><input type="submit" name="Boton2" value="Grabar" /></td>                  
         <td><input type="submit" name="Boton2" value="Cancelar" /></td>         
         </tr>
      </table>   
      {% endif %}
   </div>
   </div>
   <div id="content"></div>
   <div id="footer"></div>
   </div>
</form>
</body>
</html>